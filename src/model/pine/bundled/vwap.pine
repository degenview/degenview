//@version=6
// Built-in indicator bundled with DegenView. Original work, GPL-3.0-only.
// Volume Weighted Average Price, restarted at the start of each day, with bands a multiple of
// the volume-weighted standard deviation away. It needs volume, so it is flat on a market
// that reports none.
indicator("VWAP", overlay = true)

source = input.source(hlc3, "Source")
mult = input.float(1.0, "Band multiplier", minval = 0.1, step = 0.1)

[vwap, upper, lower] = ta.vwap(source, timeframe.change("D"), mult)

plot(vwap, "VWAP", color = color.purple, linewidth = 2)
top = plot(upper, "Upper band", color = color.new(color.purple, 40))
bottom = plot(lower, "Lower band", color = color.new(color.purple, 40))
fill(top, bottom, color = color.new(color.purple, 92), title = "Bands")
