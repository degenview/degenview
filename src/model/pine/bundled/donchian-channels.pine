//@version=6
// Built-in indicator bundled with DegenView. Original work, GPL-3.0-only.
// Donchian Channels: the highest high and lowest low over the last N bars, with their midpoint.
// A close beyond a band is a breakout.
indicator("Donchian Channels", overlay = true)

length = input.int(20, "Length", minval = 1)

upper = ta.highest(high, length)
lower = ta.lowest(low, length)
basis = math.avg(upper, lower)

top = plot(upper, "Upper", color = color.blue)
plot(basis, "Basis", color = color.orange)
bottom = plot(lower, "Lower", color = color.blue)
fill(top, bottom, color = color.new(color.blue, 92), title = "Channel")
