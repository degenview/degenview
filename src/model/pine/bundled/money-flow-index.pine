//@version=6
// Built-in indicator bundled with DegenView. Original work, GPL-3.0-only.
// Money Flow Index: an RSI that also weighs volume, from 0 to 100. Above 80 is overbought and
// below 20 is oversold; price making a new extreme that MFI does not confirm is a divergence.
indicator("Money Flow Index", overlay = false)

length = input.int(14, "Length", minval = 1)
upperLevel = input.int(80, "Overbought", minval = 50, maxval = 100)
lowerLevel = input.int(20, "Oversold", minval = 0, maxval = 50)

value = ta.mfi(hlc3, length)

plot(value, "MFI", color = color.purple, linewidth = 2)
top = hline(upperLevel, "Overbought", color = color.gray)
hline(50, "Midline", color = color.new(color.gray, 60))
bottom = hline(lowerLevel, "Oversold", color = color.gray)
fill(top, bottom, color = color.new(color.purple, 94), title = "Range")
